{
  "name": "@chaingpt/mcp-server",
  "version": "1.22.2",
  "description": "MCP server exposing ChainGPT Web3 AI APIs + generic Web3 tools + mainnet deploy + mainnet DEX (OpenOcean + 1inch + CoW + Jupiter) + mainnet DeFi (Aave + Lido + EigenLayer + Pendle + Morpho) + perps (Hyperliquid + Drift) + Polymarket + Across cross-chain bridge + multi-protocol portfolio snapshot as tools for Claude",
  "main": "dist/index.js",
  "bin": {
    "chaingpt-mcp": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "ts-node --esm src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "npm run build && node dist/smoke-test.js"
  },
  "dependencies": {
    "@chaingpt/ainews": "0.0.9",
    "@chaingpt/generalchat": "0.0.17",
    "@chaingpt/nft": "0.1.2",
    "@chaingpt/smartcontractauditor": "0.0.2",
    "@chaingpt/smartcontractgenerator": "0.0.5",
    "@kamino-finance/klend-sdk": "5.15.4",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@mrgnlabs/marginfi-client-v2": "6.4.1",
    "@mrgnlabs/mrgn-common": "2.0.7",
    "@msgpack/msgpack": "3.1.3",
    "@solana/web3.js": "1.99.0",
    "dotenv": "16.6.1",
    "qrcode": "1.5.4",
    "solc": "0.8.36",
    "viem": "2.56.3"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.0.2",
    "@openzeppelin/contracts-upgradeable": "5.0.2",
    "@types/node": "20.19.39",
    "@types/qrcode": "1.5.6",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "keywords": [
    "chaingpt",
    "mcp",
    "model-context-protocol",
    "web3",
    "ai",
    "blockchain",
    "claude"
  ],
  "license": "MIT",
  "overrides": {
    "axios@<1": "0.33.0",
    "bigint-buffer": "npm:@exodus/bigint-buffer@1.1.5-exodus.1",
    "tmp": "0.2.7",
    "toml": "4.2.0",
    "uuid@<11.1.1": "11.1.1"
  }
}
