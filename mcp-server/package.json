    "jayson": "5.0.0",
    "qs": "6.16.1",
    "source-map-js": "1.2.2",
    "tmp": "0.2.7",
    "toml": "5.0.1",
    "uuid@<11.1.1": "11.1.1",
    "vite": "8.2.4",
    "zod": "4.6.6"
  }
}
