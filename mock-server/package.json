{
  "name": "@chaingpt/mock-server",
  "version": "1.0.0",
  "description": "Mock server for ChainGPT APIs — develop and test without spending credits",
  "main": "dist/index.js",
  "bin": {
    "chaingpt-mock": "dist/index.js"
  },
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "4.22.1",
    "cors": "2.8.6"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "ts-node": "10.9.2",
    "@types/express": "4.17.25",
    "@types/cors": "2.8.19",
    "@types/node": "20.19.39",
    "vitest": "4.1.11",
    "supertest": "7.2.2",
    "@types/supertest": "6.0.3"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
